#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ЗаполнитьПоРеализации(ДанныеЗаполнения);
	КонецЕсли;

	ЗаполнитьЗначенияПоУмолчанию();

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Статус = Перечисления.рек_СтатусыРекламаций.Новая;
	Ответственный = Пользователи.ТекущийПользователь();

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	ПроверитьКоличествоПоРеализации(Отказ);

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Запоминаем до записи, изменился ли статус: после записи старое значение уже не прочитать.
	ДополнительныеСвойства.Вставить("рек_СтатусИзменен", СтатусИзменен());

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ДополнительныеСвойства.Свойство("рек_СтатусИзменен")
		И ДополнительныеСвойства.рек_СтатусИзменен Тогда
		ЗаписатьИсториюСтатуса();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.рек_Рекламации.Записывать = Истина;

	// Одна и та же номенклатура с одной причиной может встречаться в нескольких строках -
	// сворачиваем, чтобы в регистре была одна запись на ключ.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Причина КАК Причина,
	|	Товары.Количество КАК Количество,
	|	Товары.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТовары.Номенклатура КАК Номенклатура,
	|	ВТТовары.Причина КАК Причина,
	|	СУММА(ВТТовары.Количество) КАК Количество,
	|	СУММА(ВТТовары.Сумма) КАК Сумма
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТТовары.Номенклатура,
	|	ВТТовары.Причина";

	Запрос.УстановитьПараметр("Товары", Товары.Выгрузить(, "Номенклатура, Причина, Количество, Сумма"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Движение = Движения.рек_Рекламации.Добавить();
		Движение.Период       = Дата;
		Движение.Организация  = Организация;
		Движение.Контрагент   = Контрагент;
		Движение.Статус       = Статус;
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.Причина      = Выборка.Причина;
		Движение.Количество   = Выборка.Количество;
		Движение.Сумма        = Выборка.Сумма;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьЗначенияПоУмолчанию()

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.рек_СтатусыРекламаций.Новая;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;

КонецПроцедуры

// Заполняет шапку и товары рекламации по документу реализации.
// Берутся и товары, и услуги реализации. Одинаковая номенклатура из нескольких строк
// сворачивается в одну строку.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг - документ-основание.
//
Процедура ЗаполнитьПоРеализации(Реализация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реализация.Организация КАК Организация,
	|	Реализация.Контрагент КАК Контрагент,
	|	Реализация.Проведен КАК Проведен
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Ссылка = &Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК Порядок,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА Товары.Ссылка.СуммаВключаетНДС
	|			ТОГДА Товары.Сумма
	|		ИНАЧЕ Товары.Сумма + Товары.СуммаНДС
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ ВТСтроки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Реализация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2,
	|	Услуги.НомерСтроки,
	|	Услуги.Номенклатура,
	|	Услуги.Количество,
	|	ВЫБОР
	|		КОГДА Услуги.Ссылка.СуммаВключаетНДС
	|			ТОГДА Услуги.Сумма
	|		ИНАЧЕ Услуги.Сумма + Услуги.СуммаНДС
	|	КОНЕЦ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК Услуги
	|ГДЕ
	|	Услуги.Ссылка = &Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСтроки.Номенклатура КАК Номенклатура,
	|	СУММА(ВТСтроки.Количество) КАК Количество,
	|	СУММА(ВТСтроки.Сумма) КАК Сумма,
	|	МИНИМУМ(ВТСтроки.Порядок * 100000 + ВТСтроки.НомерСтроки) КАК Порядок
	|ИЗ
	|	ВТСтроки КАК ВТСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСтроки.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	
	Запрос.УстановитьПараметр("Реализация", Реализация);
	РезультатыПакета = Запрос.ВыполнитьПакет();

	Шапка = РезультатыПакета[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	Если Не Шапка.Проведен Тогда
		ВызватьИсключение НСтр("ru = 'Рекламацию можно ввести только по проведенному документу реализации.'");
	КонецЕсли;

	Организация = Шапка.Организация;
	Контрагент = Шапка.Контрагент;
	ДокументРеализации = Реализация;

	Товары.Очистить();
	ВыборкаТовары = РезультатыПакета[2].Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТовары, "Номенклатура, Количество, Сумма");
	КонецЦикла;

КонецПроцедуры

// Проверяет, что по каждой номенклатуре заявлено не больше, чем продано по реализации
// (товары и услуги).
// Сравнение идет по суммам, сгруппированным по номенклатуре: одна позиция в нескольких
// строках рекламации не должна обходить проверку.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при нарушении.
//
Процедура ПроверитьКоличествоПоРеализации(Отказ)

	Если Не ЗначениеЗаполнено(ДокументРеализации) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество
	|ПОМЕСТИТЬ ВТСтрокиРекламации
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСтрокиРекламации.Номенклатура КАК Номенклатура,
	|	СУММА(ВТСтрокиРекламации.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТРекламация
	|ИЗ
	|	ВТСтрокиРекламации КАК ВТСтрокиРекламации
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСтрокиРекламации.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество
	|ПОМЕСТИТЬ ВТСтрокиРеализации
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Реализация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Услуги.Номенклатура,
	|	Услуги.Количество
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК Услуги
	|ГДЕ
	|	Услуги.Ссылка = &Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСтрокиРеализации.Номенклатура КАК Номенклатура,
	|	СУММА(ВТСтрокиРеализации.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТОтгружено
	|ИЗ
	|	ВТСтрокиРеализации КАК ВТСтрокиРеализации
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСтрокиРеализации.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРекламация.Номенклатура КАК Номенклатура,
	|	ВТРекламация.Количество КАК Количество,
	|	ЕСТЬNULL(ВТОтгружено.Количество, 0) КАК Отгружено
	|ИЗ
	|	ВТРекламация КАК ВТРекламация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОтгружено КАК ВТОтгружено
	|		ПО ВТРекламация.Номенклатура = ВТОтгружено.Номенклатура
	|ГДЕ
	|	ВТРекламация.Количество > ЕСТЬNULL(ВТОтгружено.Количество, 0)";

	Запрос.УстановитьПараметр("Товары", Товары.Выгрузить(, "Номенклатура, Количество"));
	Запрос.УстановитьПараметр("Реализация", ДокументРеализации);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(
			НСтр("ru = 'По позиции ""%1"" заявлено %2, а по реализации продано только %3.'"),
			Выборка.Номенклатура, Выборка.Количество, Выборка.Отгружено);
		Сообщение.Поле = "Товары";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры

Функция СтатусИзменен()

	Если ЭтоНовый() Тогда
		Возврат Истина;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Рекламация.Статус КАК Статус
	|ИЗ
	|	Документ.рек_Рекламация КАК Рекламация
	|ГДЕ
	|	Рекламация.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Выборка.Статус <> Статус;

КонецФункции

Процедура ЗаписатьИсториюСтатуса()

	Запись = РегистрыСведений.рек_ИсторияСтатусов.СоздатьМенеджерЗаписи();
	Запись.Период        = ТекущаяДатаСеанса();
	Запись.Рекламация    = Ссылка;
	Запись.Статус        = Статус;
	Запись.Ответственный = Ответственный;
	Запись.Автор         = Пользователи.ТекущийПользователь();
	Запись.Записать();

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
