#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Формирует печатную форму «Акт рекламации».
// Макет строится кодом: реквизиты, таблица товаров с итогом, описание претензии и подписи сторон.
//
// Параметры:
//  Ссылка - ДокументСсылка.рек_Рекламация - рекламация для печати.
//
// Возвращаемое значение:
//  ТабличныйДокумент - готовая печатная форма.
//
Функция СформироватьАктРекламации(Ссылка) Экспорт

	РезультатыПакета = ДанныеДляПечати(Ссылка);

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.АвтоМасштаб = Истина;

	Шапка = РезультатыПакета[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат ТабДок;
	КонецЕсли;

	Колонки = КолонкиТаблицы();
	Для Каждого Колонка Из Колонки Цикл
		ТабДок.Область(1, Колонка.Номер, 1, Колонка.Номер).ШиринаКолонки = Колонка.Ширина;
	КонецЦикла;
	ПерваяКолонка = 1;
	ПоследняяКолонка = Колонки.Количество();
	КолонкаЗначения = 3; // реквизиты шапки: подпись в колонках 1-2, значение в 3-5

	Оформление = Новый Структура;
	Оформление.Вставить("ШрифтЗаголовка", Новый Шрифт(, 14, Истина));
	Оформление.Вставить("ШрифтЖирный", Новый Шрифт(, , Истина));
	Оформление.Вставить("Линия", Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1));

	// Заголовок
	НомерСтроки = 1;
	Область = ТабДок.Область(НомерСтроки, ПерваяКолонка, НомерСтроки, ПоследняяКолонка);
	Область.Объединить();
	Область.Текст = СтрШаблон(НСтр("ru = 'Акт рекламации № %1 от %2'"), Шапка.Номер, Формат(Шапка.Дата, "ДЛФ=D"));
	Область.Шрифт = Оформление.ШрифтЗаголовка;
	НомерСтроки = НомерСтроки + 2;

	// Реквизиты шапки
	Реквизиты = Новый СписокЗначений;
	Реквизиты.Добавить(Шапка.Организация, НСтр("ru = 'Организация:'"));
	Реквизиты.Добавить(Шапка.Контрагент, НСтр("ru = 'Покупатель:'"));
	Реквизиты.Добавить(Шапка.ДокументРеализации, НСтр("ru = 'Основание:'"));
	Реквизиты.Добавить(Шапка.Статус, НСтр("ru = 'Статус:'"));
	Реквизиты.Добавить(Шапка.Ответственный, НСтр("ru = 'Ответственный:'"));
	Для Каждого Реквизит Из Реквизиты Цикл
		ВывестиСтрокуРеквизита(ТабДок, НомерСтроки, КолонкаЗначения, ПоследняяКолонка,
			Реквизит.Представление, Строка(Реквизит.Значение), Оформление);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	// Шапка таблицы
	Для Каждого Колонка Из Колонки Цикл
		ТекЯчейка = Ячейка(ТабДок, НомерСтроки, Колонка.Номер);
		ТекЯчейка.Текст = Колонка.Заголовок;
		ТекЯчейка.Шрифт = Оформление.ШрифтЖирный;
		ТекЯчейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		ТекЯчейка.Обвести(Оформление.Линия, Оформление.Линия, Оформление.Линия, Оформление.Линия);
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	// Строки таблицы
	ИтогоКоличество = 0;
	ИтогоСумма = 0;
	Выборка = РезультатыПакета[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого Колонка Из Колонки Цикл
			ТекЯчейка = Ячейка(ТабДок, НомерСтроки, Колонка.Номер);
			ТекЯчейка.Текст = ТекстЗначения(Выборка[Колонка.Поле], Колонка.Формат);
			ТекЯчейка.Обвести(Оформление.Линия, Оформление.Линия, Оформление.Линия, Оформление.Линия);
			Если ЗначениеЗаполнено(Колонка.Формат) Тогда
				ТекЯчейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
			КонецЕсли;
		КонецЦикла;
		ИтогоКоличество = ИтогоКоличество + Выборка.Количество;
		ИтогоСумма = ИтогоСумма + Выборка.Сумма;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	// Итог: подпись под колонкой номенклатуры, суммы под своими колонками
	Итоги = Новый Структура("Номенклатура, Количество, Сумма", НСтр("ru = 'Итого:'"), ИтогоКоличество, ИтогоСумма);
	Для Каждого Колонка Из Колонки Цикл
		Если Не Итоги.Свойство(Колонка.Поле) Тогда
			Продолжить;
		КонецЕсли;
		ТекЯчейка = Ячейка(ТабДок, НомерСтроки, Колонка.Номер);
		ТекЯчейка.Текст = ТекстЗначения(Итоги[Колонка.Поле], Колонка.Формат);
		ТекЯчейка.Шрифт = Оформление.ШрифтЖирный;
		ТекЯчейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 2;

	// Описание претензии
	Если ЗначениеЗаполнено(Шапка.Комментарий) Тогда
		ВывестиСтрокуРеквизита(ТабДок, НомерСтроки, КолонкаЗначения, ПоследняяКолонка,
			НСтр("ru = 'Описание претензии:'"), Шапка.Комментарий, Оформление);
		НомерСтроки = НомерСтроки + 2;
	КонецЕсли;

	// Подписи
	МестоПодписи = "_______________ / _______________________";
	Для Каждого Сторона Из СтрРазделить(НСтр("ru = 'От организации:;От покупателя:'"), ";") Цикл
		ВывестиСтрокуРеквизита(ТабДок, НомерСтроки, КолонкаЗначения, ПоследняяКолонка,
			Сторона, МестоПодписи, Оформление);
		НомерСтроки = НомерСтроки + 2;
	КонецЦикла;

	Возврат ТабДок;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеДляПечати(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Рекламация.Номер КАК Номер,
	|	Рекламация.Дата КАК Дата,
	|	Рекламация.Организация КАК Организация,
	|	Рекламация.Контрагент КАК Контрагент,
	|	Рекламация.ДокументРеализации КАК ДокументРеализации,
	|	Рекламация.Статус КАК Статус,
	|	Рекламация.Ответственный КАК Ответственный,
	|	Рекламация.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.рек_Рекламация КАК Рекламация
	|ГДЕ
	|	Рекламация.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество,
	|	Товары.Сумма КАК Сумма,
	|	Товары.Причина КАК Причина
	|ИЗ
	|	Документ.рек_Рекламация.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Возврат Запрос.ВыполнитьПакет();

КонецФункции

// Описание колонок таблицы товаров: номер, поле выборки, заголовок, ширина, формат числа.
Функция КолонкиТаблицы()

	Колонки = Новый Массив;
	Описание = "Поле, Заголовок, Ширина, Формат";
	Колонки.Добавить(Новый Структура(Описание, "НомерСтроки", НСтр("ru = 'N'"), 5, ""));
	Колонки.Добавить(Новый Структура(Описание, "Номенклатура", НСтр("ru = 'Номенклатура'"), 45, ""));
	Колонки.Добавить(Новый Структура(Описание, "Количество", НСтр("ru = 'Количество'"), 12, "ЧДЦ=3; ЧН=0"));
	Колонки.Добавить(Новый Структура(Описание, "Сумма", НСтр("ru = 'Сумма'"), 14, "ЧДЦ=2; ЧН=0"));
	Колонки.Добавить(Новый Структура(Описание, "Причина", НСтр("ru = 'Причина'"), 25, ""));

	НомерКолонки = 0;
	Для Каждого Колонка Из Колонки Цикл
		НомерКолонки = НомерКолонки + 1;
		Колонка.Вставить("Номер", НомерКолонки);
	КонецЦикла;

	Возврат Колонки;

КонецФункции

// Выводит строку «подпись: значение»: подпись в колонках до КолонкаЗначения, значение - до ПоследняяКолонка.
Процедура ВывестиСтрокуРеквизита(ТабДок, НомерСтроки, КолонкаЗначения, ПоследняяКолонка, Подпись, Значение, Оформление)

	ОбластьПодписи = ТабДок.Область(НомерСтроки, 1, НомерСтроки, КолонкаЗначения - 1);
	ОбластьПодписи.Объединить();
	ОбластьПодписи.Текст = Подпись;
	ОбластьПодписи.Шрифт = Оформление.ШрифтЖирный;

	ОбластьЗначения = ТабДок.Область(НомерСтроки, КолонкаЗначения, НомерСтроки, ПоследняяКолонка);
	ОбластьЗначения.Объединить();
	ОбластьЗначения.Текст = Значение;
	ОбластьЗначения.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;

КонецПроцедуры

Функция ТекстЗначения(Значение, ФорматЧисла)

	Если ЗначениеЗаполнено(ФорматЧисла) Тогда
		Возврат Формат(Значение, ФорматЧисла);
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция Ячейка(ТабДок, НомерСтроки, НомерКолонки)

	Возврат ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);

КонецФункции

#КонецОбласти

#КонецЕсли
