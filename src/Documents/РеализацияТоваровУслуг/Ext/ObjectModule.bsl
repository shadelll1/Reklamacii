#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Перехват типовой ОбработкаУдаленияПроведения: нельзя отменить проведение реализации,
// по которой есть проведенные рекламации, иначе рекламации будут ссылаться на непроведенную отгрузку.
// Типовой код БП не меняется - проверка выполняется до него.
//
&Перед("ОбработкаУдаленияПроведения")
Процедура рек_ОбработкаУдаленияПроведенияПеред(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Рекламация.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.рек_Рекламация КАК Рекламация
	|ГДЕ
	|	Рекламация.ДокументРеализации = &Реализация
	|	И Рекламация.Проведен";
	Запрос.УстановитьПараметр("Реализация", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(
			НСтр("ru = 'Нельзя отменить проведение: по реализации оформлена рекламация %1.
			|Сначала отмените проведение рекламации.'"),
			Выборка.Ссылка);
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
